# Runtime H2 database (created by the app at runtime, not source)
data/*.db

# Runtime app settings (written by the app via SettingsService; each host keeps
# its own). The app auto-creates it with sane defaults on first run.
conf/clamav-web-client.properties

# Maven build output. Also '?': a container build with no passwd entry for its
# uid resolves Java's user.home to "?" and drops the whole .m2 cache there.
target/
/?/
